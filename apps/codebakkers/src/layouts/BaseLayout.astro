---
import "@codebakkers/ui/styles/global.css";
import BaseHead from "@codebakkers/ui/components/BaseHead.astro";
import Header from "@codebakkers/ui/components/Header.astro";
import Footer from "@codebakkers/ui/components/Footer.astro";
import Analytics from "@codebakkers/ui/components/Analytics.astro";
import { SITE } from "../consts";

interface Props {
  title: string;
  description?: string;
  type?: "website" | "article";
  canonical?: string;
  image?: string;
}
const { title, description = SITE.description, type = "website", canonical, image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      site={SITE.title}
      type={type}
      canonical={canonical}
      image={image}
      rss={true}
    />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header
      brand={SITE.brand}
      brandHref="/"
      nav={[...SITE.nav]}
      cta={{ href: "/#contact", label: "Get in touch" }}
    />
    <main id="main">
      <slot />
    </main>
    <Footer
      name={SITE.brand}
      brand={SITE.brand}
      tagline="baked in, not bolted on"
      social={[...SITE.social]}
    />
  </body>
</html>
