---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import { getCollection } from "astro:content";
import { SITE } from "../../consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" }).toUpperCase();
const iso = (d: Date) => d.toISOString().slice(0, 10);
const colors = ["tile-blush", "tile-sky", "tile-mint", "tile-yellow", "tile-paper", "tile-coral"];
---

<BaseLayout title={`Blog — ${SITE.title}`} description={SITE.description}>
  <Container>
    <section class="bento" aria-labelledby="intro-h">
      <div class="tile tile-pine page-head intro">
        <p class="label">Blog</p>
        <h1 id="intro-h" class="display">{SITE.tagline}</h1>
        <p class="lead">
          What worked, what broke and what we learned while moving large frontend platforms forward:
          migrations, build tooling and the edge. A field report each week, a longer deep dive each
          month.
        </p>
      </div>
      <a class="tile tile-yellow rss" href="/rss.xml">
        <span class="label">Subscribe</span>
        <span class="rss-t">RSS feed</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </section>

    <section aria-label="Posts">
      <ul class="bento posts">
        {
          posts.map((post, i) => (
            <li class={i === 0 ? "first" : ""}>
              <a class={`tile ${colors[i % colors.length]} post`} href={`/blog/${post.id}/`}>
                <span class="label">
                  {post.data.type === "deep-dive" ? "Deep dive" : "Field report"} ·{" "}
                  <time datetime={iso(post.data.pubDate)}>{fmt(post.data.pubDate)}</time>
                </span>
                <span class="ptitle">{post.data.title}</span>
                <span class="pdesc">{post.data.description}</span>
                <span class="read">
                  Read{" "}
                  <span class="arrow" aria-hidden="true">
                    →
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      {posts.length === 0 && <p class="tile empty">First post lands Monday.</p>}
    </section>
  </Container>
</BaseLayout>

<style>
  .intro {
    grid-column: span 9;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
  .rss {
    grid-column: span 3;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }
  .rss-t {
    font-size: clamp(1.8rem, 1.4rem + 1.2vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .rss .arrow {
    font-size: 1.5rem;
  }
  .rss:hover .rss-t,
  .post:hover .ptitle {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  .posts {
    padding: 0;
    list-style: none;
  }
  .posts li {
    grid-column: span 4;
  }
  .posts li.first {
    grid-column: span 8;
  }
  .post {
    height: 100%;
    min-height: 280px;
    gap: 1rem;
    text-decoration: none;
  }
  .ptitle {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .first .ptitle {
    font-size: clamp(2rem, 1.4rem + 2vw, 3.25rem);
    max-width: 20ch;
  }
  .pdesc {
    max-width: 52ch;
  }
  .read {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (max-width: 56rem) {
    .intro,
    .rss,
    .posts li,
    .posts li.first {
      grid-column: 1 / -1;
    }
    .post {
      min-height: 0;
    }
  }
</style>
