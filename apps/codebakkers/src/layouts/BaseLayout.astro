---
import "@codebakkers/ui/styles/global.css";
import BaseHead from "@codebakkers/ui/components/BaseHead.astro";
import Header from "@codebakkers/ui/components/Header.astro";
import Footer from "@codebakkers/ui/components/Footer.astro";
import Analytics from "@codebakkers/ui/components/Analytics.astro";
import { SITE } from "../consts";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  type?: "website" | "article";
  image?: string;
}
const { title, description = SITE.description, canonical, type = "website", image } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      site={SITE.title}
      canonical={canonical}
      type={type}
      image={image}
    />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header brand={SITE.title} brandHref="/" nav={[...SITE.nav]} />
    <main id="main">
      <slot />
    </main>
    <Footer brand={SITE.title} tagline={SITE.tagline} social={[...SITE.social]} />
  </body>
</html>
