---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";
---

<BaseLayout title="Privacy — Henk Bakker" description="How this site handles your data.">
  <Container narrow>
    <section>
      <p class="kicker">PRIVACY</p>
      <h1>Privacy</h1>
      <Prose>
        <p>
          This site keeps things simple. It sets <strong>no cookies</strong> and asks for no consent banner,
          because there's nothing to consent to.
        </p>
        <p>
          Traffic is measured with <strong>Cloudflare Web Analytics</strong>, which is privacy-first
          and cookieless: it records aggregate, anonymous page views and does not fingerprint you or
          track you across sites. No personal data is collected, sold, or shared.
        </p>
        <p>
          The site is hosted on Cloudflare, which processes standard server request logs for
          security and delivery. If you email me, I'll only use your message to reply.
        </p>
        <p>Questions? <a href="mailto:hello@codebakkers.com">hello@codebakkers.com</a>.</p>
      </Prose>
    </section>
  </Container>
</BaseLayout>

<style>
  section {
    margin: var(--space-16) 0 var(--space-12);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-3);
  }
</style>
