---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";
---

<BaseLayout title="Privacy — CodeBakkers" description="How this site handles your data.">
  <Container>
    <section class="bento" aria-labelledby="privacy-h">
      <div class="tile tile-mint page-head intro">
        <p class="label">Privacy</p>
        <h1 id="privacy-h" class="display">Privacy</h1>
      </div>
      <div class="tile page-body">
        <Prose>
          <p>
            This site keeps things simple. It sets <strong>no cookies</strong> and asks for no consent
            banner, because there's nothing to consent to.
          </p>
          <p>
            Traffic is measured with <strong>Cloudflare Web Analytics</strong>, which is
            privacy-first and cookieless: it records aggregate, anonymous page views and does not
            fingerprint you or track you across sites. No personal data is collected, sold, or
            shared.
          </p>
          <p>
            The site is hosted on Cloudflare, which processes standard server request logs for
            security and delivery. If you email me, I'll only use your message to reply.
          </p>
          <p>Questions? <a href="mailto:hello@codebakkers.com">hello@codebakkers.com</a>.</p>
        </Prose>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .intro {
    grid-column: 1 / -1;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
</style>
