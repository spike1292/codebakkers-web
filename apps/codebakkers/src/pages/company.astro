---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import JsonLd from "@codebakkers/ui/components/JsonLd.astro";
import { SITE } from "../consts";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CodeBakkers",
  alternateName: "CodeBakkers B.V.",
  url: "https://codebakkers.com",
  email: "hello@codebakkers.com",
  founder: { "@type": "Person", name: "Henk Bakker", url: "https://codebakkers.com" },
  address: { "@type": "PostalAddress", addressLocality: "Uithuizen", addressCountry: "NL" },
  identifier: [
    { "@type": "PropertyValue", name: "KVK", value: "90011139" },
    { "@type": "PropertyValue", name: "BTW", value: "NL865181470B01" },
  ],
};
---

<BaseLayout title="Company — CodeBakkers" description="CodeBakkers B.V. — company profile.">
  <Container>
    <section class="bento" aria-labelledby="co-h">
      <div class="tile tile-pine page-head intro">
        <p class="label">Company</p>
        <h1 id="co-h" class="display">CodeBakkers B.V.</h1>
        <p class="lead">
          Henk Bakker's holding company and personal brand: the company behind his engineering work.
          Baked in, not bolted on.
        </p>
      </div>
      <div class="tile reg">
        <p class="label">Registration</p>
        <dl>
          <div>
            <dt>KVK</dt>
            <dd>90011139</dd>
          </div>
          <div>
            <dt>BTW / VAT</dt>
            <dd>NL865181470B01</dd>
          </div>
          <div>
            <dt>Based in</dt>
            <dd>Uithuizen, the Netherlands</dd>
          </div>
          <div>
            <dt>Email</dt>
            <dd><a href="mailto:hello@codebakkers.com">hello@codebakkers.com</a></dd>
          </div>
        </dl>
      </div>
      <a class="tile tile-yellow link" href="/cv">
        <span class="label">The person</span>
        <span class="t">Read Henk's CV</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="tile tile-sky link" href="/blog">
        <span class="label">The writing</span>
        <span class="t">{SITE.tagline}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <a class="tile tile-coral link" href="https://www.codecask.cc">
        <span class="label">Consultancy &amp; secondment</span>
        <span class="t">Hire Henk via Codecask</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </section>
  </Container>
  <JsonLd schema={org} />
</BaseLayout>

<style>
  .intro {
    grid-column: span 7;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
  .reg {
    grid-column: span 5;
  }
  dl {
    margin: 0;
  }
  dl div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding: 0.8rem 0;
    border-top: 2px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  dt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  dd {
    margin: 0;
    font-weight: 700;
  }
  dd a {
    text-decoration: underline;
  }
  .link {
    grid-column: span 4;
    min-height: 200px;
    justify-content: space-between;
    gap: 1rem;
    text-decoration: none;
  }
  .t {
    font-size: clamp(1.6rem, 1.3rem + 0.9vw, 2.1rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .link .arrow {
    font-size: 1.5rem;
  }
  .link:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }
  @media (max-width: 56rem) {
    .intro,
    .reg,
    .link {
      grid-column: 1 / -1;
    }
    .link {
      min-height: 0;
    }
  }
</style>
