---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";
---

<BaseLayout
  title="Faith — CodeBakkers"
  description="A little about my faith in Jesus, and my church community."
>
  <Container>
    <section class="bento" aria-labelledby="faith-h">
      <div class="tile tile-sky page-head intro">
        <p class="label">Faith</p>
        <h1 id="faith-h" class="display">Following Jesus</h1>
      </div>
      <div class="tile page-body">
        <Prose>
          <p>
            Alongside the engineering, the most important thing about me is that I follow Jesus. My
            faith isn't a side interest — it shapes how I try to live, work, and treat the people
            around me.
          </p>
          <p>
            I believe the good news is exactly that: good news, and it's for everyone. That people
            can know the love and the rescuing power of Jesus for themselves. It's something I care
            about enough to want to share, gently and honestly, with anyone who's curious.
          </p>
          <blockquote>
            "For I am not ashamed of the gospel, because it is the power of God that brings
            salvation to everyone who believes." — Romans 1:16
          </blockquote>

          <h2>My church — Farmhouse Church</h2>
          <p>
            I'm part of <a href="https://defarmhouse.nl">Farmhouse Church</a>, a New Testament
            church in Garsthuizen, Groningen, committed to the Great Commission and to serving
            people across the region — young and old alike.
          </p>
          <p>
            We gather every Sunday morning at 9:30 (Smydingheweg 46, Garsthuizen). If you'd like to
            come along, or just want to talk about any of this, you're genuinely welcome — reach out
            any time.
          </p>
          <p>
            <a class="btn btn-yellow" href="https://defarmhouse.nl"
              >Visit Farmhouse Church <span class="arrow" aria-hidden="true">→</span></a
            >
          </p>
        </Prose>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .intro {
    grid-column: 1 / -1;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
</style>
