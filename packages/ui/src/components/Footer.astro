---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
interface LinkItem {
  label: string;
  href: string;
}
interface Props {
  name?: string;
  brand?: string;
  tagline?: string;
  social?: LinkItem[];
}
const { name = "Henk Bakker", brand = "CodeBakkers", tagline = "", social = [] } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="box">
      <div class="top">
        <Logo label={name} />
        {
          social.length > 0 && (
            <ul class="links" aria-label="Elsewhere">
              {social.map((l) => (
                <li>
                  <a href={l.href} rel="me">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
      <div class="sub">
        <p class="brand">© {year} {brand}{tagline ? ` — ${tagline}` : ""}</p>
        <ul class="links">
          <li><a href="/privacy">Privacy</a></li>
          <li><a href="/company">Company</a></li>
          <li><a href="https://www.codecask.cc">codecask.cc</a></li>
        </ul>
      </div>
    </div>
  </Container>
</footer>
<style>
  .site-footer {
    margin-top: var(--gap);
    padding-bottom: var(--gap);
  }
  .box {
    border-radius: var(--radius-tile);
    padding: 1.6rem 1.9rem;
    background: var(--tile-ink-bg);
    color: var(--tile-ink-fg);
  }
  .top,
  .sub {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: center;
    justify-content: space-between;
  }
  .sub {
    margin-top: var(--space-6);
    padding-top: var(--space-4);
    border-top: 2px dashed color-mix(in srgb, currentColor 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding: 0;
    margin: 0;
  }
  .links a {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--cb-yellow);
    text-decoration: underline;
  }
</style>
