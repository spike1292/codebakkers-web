---
import Container from "./Container.astro";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
interface NavItem {
  href: string;
  label: string;
}
interface Props {
  brand?: string;
  brandHref?: string;
  nav?: NavItem[];
  cta?: NavItem;
}
const { brand = "Henk Bakker", brandHref = "/", nav = [], cta } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="site-header">
  <Container>
    <div class="bar">
      <Logo label={brand} href={brandHref} />
      {
        nav.length > 0 && (
          <nav aria-label="Primary">
            <ul>
              {nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <div class="right">
        <ThemeToggle />
        {
          cta && (
            <a class="btn btn-coral hire" href={cta.href}>
              {cta.label}{" "}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>
    </div>
  </Container>
</header>
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: var(--gap);
    margin-bottom: var(--gap);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.55rem 0.55rem 0.55rem 1.4rem;
    border-radius: var(--radius-pill);
    background: var(--tile-ink-bg);
    color: var(--tile-ink-fg);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--tile-ink-fg) 10%, transparent);
  }
  .right {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  nav ul {
    list-style: none;
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
  }
  nav a {
    display: block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius-pill);
    color: inherit;
    text-decoration: none;
    font-weight: 600;
  }
  nav a:hover {
    color: inherit;
    background: color-mix(in srgb, var(--tile-ink-fg) 12%, transparent);
  }
  nav a[aria-current="page"] {
    background: var(--cb-yellow);
    color: var(--cb-ink);
  }
  .hire {
    padding: 0.7rem 1.3rem;
  }
  @media (max-width: 56rem) {
    .bar {
      flex-wrap: wrap;
      border-radius: var(--radius-tile);
      padding: 0.5rem 0.5rem 0.5rem 1.1rem;
      row-gap: 0.35rem;
    }
    nav {
      order: 3;
      flex-basis: 100%;
      overflow-x: auto;
      margin-inline: -0.6rem -0.5rem;
      padding-bottom: 0.15rem;
    }
    nav a {
      padding: 0.45rem 0.8rem;
      font-size: 0.95rem;
    }
  }
  @media (max-width: 26rem) {
    .bar {
      column-gap: 0.5rem;
    }
    .bar :global(.logo) {
      font-size: 1.1rem;
      gap: 0.5rem;
    }
    .hire {
      padding: 0.6rem 1rem;
      font-size: 0.95rem;
    }
  }
</style>
