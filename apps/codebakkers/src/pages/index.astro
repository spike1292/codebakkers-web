---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import JsonLd from "@codebakkers/ui/components/JsonLd.astro";
import { SITE } from "../consts";

const destinations = [
  {
    kicker: "THE PERSON",
    name: "Henk Bakker",
    href: "https://henkbakker.net",
    blurb:
      "Independent platform engineer — large-scale Angular modernization, frontend to edge. Background, selected work, and weekly notes from the platform.",
    cta: "henkbakker.net",
  },
  {
    kicker: "THE FIRM",
    name: "Codecask",
    href: "https://www.codecask.cc",
    blurb:
      "The consultancy — professional geeks delivering working software. Engage a team for your platform, front end, or cloud work.",
    cta: "codecask.cc",
  },
];

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CodeBakkers",
  url: SITE.url,
  email: SITE.email,
  founder: { "@type": "Person", name: "Henk Bakker", url: "https://henkbakker.net" },
  subOrganization: { "@type": "Organization", name: "Codecask", url: "https://www.codecask.cc" },
};
---

<BaseLayout title="CodeBakkers — independent engineering">
  <Container>
    <section class="hero" aria-labelledby="hero-h">
      <p class="kicker">CODEBAKKERS</p>
      <h1 id="hero-h">The company behind <span class="accent">independent engineering</span> work.</h1>
      <p class="lead">
        CodeBakkers is Henk Bakker's company. Looking for the person or the firm? Both are one click
        away.
      </p>
    </section>

    <section aria-label="Where to go next">
      <div class="cards">
        {destinations.map((d) => (
          <article class="card">
            <p class="card-kicker">{d.kicker}</p>
            <h2>{d.name}</h2>
            <p class="blurb">{d.blurb}</p>
            <a class="go" href={d.href}>{d.cta} →</a>
          </article>
        ))}
      </div>
    </section>

    <section class="foot" aria-label="Company">
      <p>
        CodeBakkers B.V. · KVK 90011139 ·
        <a href="/company">company details</a> ·
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>
  </Container>
  <JsonLd schema={org} />
</BaseLayout>

<style>
  .hero { margin: var(--space-16) 0 var(--space-12); max-width: var(--measure); }
  .kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--color-accent-strong); margin-bottom: var(--space-3); }
  .hero h1 { font-size: var(--step-4); }
  .accent { color: var(--color-accent); }
  .lead { color: var(--color-text-soft); font-size: var(--step-1); margin-top: var(--space-4); }
  .cards { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
  @media (max-width: 44rem) { .cards { grid-template-columns: 1fr; } }
  .card { border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-8); background: var(--color-surface); display: flex; flex-direction: column; }
  .card-kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--color-muted); }
  .card h2 { margin: var(--space-2) 0 var(--space-3); }
  .blurb { color: var(--color-text-soft); margin-bottom: var(--space-6); flex: 1; }
  .go { font-family: var(--font-mono); font-weight: 600; text-decoration: none; color: var(--color-accent-strong); }
  .go:hover { color: var(--color-accent); }
  .foot { margin: var(--space-16) 0 var(--space-8); color: var(--color-muted); font-size: var(--step--1); }
</style>
