---
interface Props {
  label?: string;
  href?: string;
}
const { label = "Henk Bakker", href = "/" } = Astro.props;
const initials = (label.match(/[A-Z]/g) ?? [label[0]]).join("").toLowerCase();
---

<a class="logo" href={href} aria-label={label}>
  <span class="mark" aria-hidden="true">{initials}</span>
  <span class="wordmark" aria-hidden="true">{label}</span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 50%;
    background: var(--cb-yellow);
    color: var(--cb-ink);
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }
  .logo:hover {
    color: inherit;
  }
  .logo:hover .mark {
    background: var(--cb-coral);
  }
</style>
