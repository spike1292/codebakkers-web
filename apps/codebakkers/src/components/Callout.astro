---
interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}
const { type = "note", title } = Astro.props;
const label = title ?? { note: "Note", tip: "Tip", warning: "Watch out" }[type];
---

<aside class={`callout ${type}`} role="note">
  <p class="callout-title">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>
<style>
  .callout {
    --callout: var(--cb-sky);
    border-left: 6px solid var(--callout);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
    background: var(--color-bg);
  }
  .callout.tip {
    --callout: var(--cb-mint);
  }
  .callout.warning {
    --callout: var(--cb-coral);
  }
  .callout-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .callout-title::before {
    content: "";
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--callout);
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
