---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";
---

<BaseLayout
  title="Faith · CodeBakkers"
  description="A little about my faith in Jesus, and my church community."
>
  <Container>
    <section class="bento" aria-labelledby="faith-h">
      <div class="tile tile-sky page-head intro">
        <p class="label">Faith</p>
        <h1 id="faith-h" class="display">Following Jesus</h1>
      </div>
      <div class="tile page-body">
        <Prose>
          <p>
            Most of this site is about engineering. This page is about what matters most to me: I
            follow Jesus. My faith shapes how I live, how I work and how I treat the people around
            me.
          </p>
          <p>
            I believe the good news really is good news, and it is for everyone. Anyone can know the
            love and the rescuing power of Jesus for themselves. I like to share that, gently and
            honestly, with anyone who is curious.
          </p>
          <blockquote>
            <p>
              "For I am not ashamed of the gospel, because it is the power of God that brings
              salvation to everyone who believes."
            </p>
            <cite>Romans 1:16</cite>
          </blockquote>

          <h2>My church: Farmhouse Church</h2>
          <p>
            I'm part of <a href="https://defarmhouse.nl">Farmhouse Church</a>, a New Testament
            church in Garsthuizen, Groningen. It is committed to the Great Commission and serves
            people across the region, young and old.
          </p>
          <p>
            We meet every Sunday morning at 9:30, at Smydingheweg 46 in Garsthuizen. Come along, or
            just send me a message. You are very welcome.
          </p>
          <p>
            <a class="btn btn-yellow" href="https://defarmhouse.nl"
              >Visit Farmhouse Church <span class="arrow" aria-hidden="true">→</span></a
            >
          </p>
        </Prose>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .intro {
    grid-column: 1 / -1;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
  cite {
    display: block;
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8em;
    font-style: normal;
    letter-spacing: 0.04em;
  }
</style>
