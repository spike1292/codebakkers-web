---
import BaseLayout from "./BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";
import JsonLd from "@codebakkers/ui/components/JsonLd.astro";
import { SITE } from "../consts";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Related {
  slug: string;
  title: string;
}
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  author?: string;
  type?: "field-report" | "deep-dive";
  readingTime?: string;
  headings?: Heading[];
  related?: Related[];
  slug: string;
}
const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  author = SITE.author,
  type = "field-report",
  readingTime = "",
  headings = [],
  related = [],
  slug,
} = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
const iso = (d: Date) => d.toISOString();
const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const canonical = new URL(`/blog/${slug}/`, Astro.site).toString();
const toc = type === "deep-dive" ? headings.filter((h) => h.depth === 2 || h.depth === 3) : [];
const kicker = type === "deep-dive" ? "Deep dive" : "Field report";
const relatedColors = ["tile-blush", "tile-sky", "tile-mint"];

const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  datePublished: iso(pubDate),
  dateModified: iso(updatedDate ?? pubDate),
  author: { "@type": "Person", name: author, url: SITE.url },
  publisher: { "@type": "Person", name: SITE.author, url: SITE.url },
  mainEntityOfPage: canonical,
  keywords: tags.join(", "),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Blog", item: SITE.url + "/blog/" },
    { "@type": "ListItem", position: 2, name: title, item: canonical },
  ],
};
---

<BaseLayout title={`${title} — CodeBakkers`} description={description} type="article">
  <Container>
    <article>
      <header class={`tile ${type === "deep-dive" ? "tile-pine" : "tile-ink"} post-head`}>
        <p class="label">{kicker}{readingTime && ` · ${readingTime}`}</p>
        <h1 class="display">{title}</h1>
        <p class="desc">{description}</p>
        <p class="meta">
          <span>{author}</span> ·
          <time datetime={isoDate(pubDate)}>{fmt(pubDate)}</time>
          {
            updatedDate && (
              <span>
                {" "}
                · updated <time datetime={isoDate(updatedDate)}>{fmt(updatedDate)}</time>
              </span>
            )
          }
        </p>
        {
          tags.length > 0 && (
            <ul class="chips" aria-label="Tags">
              {tags.map((t) => (
                <li class="chip">#{t}</li>
              ))}
            </ul>
          )
        }
      </header>

      <div class="tile page-body">
        {
          toc.length > 0 && (
            <nav class="toc" aria-label="Table of contents">
              <p class="label">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "sub" : ""}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <Prose>
          <slot />
        </Prose>
      </div>

      <footer class="post-foot">
        {
          related.length > 0 && (
            <section class="related" aria-labelledby="related-h">
              <h2 id="related-h" class="display">
                Related
              </h2>
              <ul>
                {related.map((r, i) => (
                  <li>
                    <a
                      class={`tile ${relatedColors[i % relatedColors.length]}`}
                      href={`/blog/${r.slug}/`}
                    >
                      {r.title}
                      <span class="arrow" aria-hidden="true">
                        →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <div class="tile tile-yellow back">
          <a class="btn" href="/blog/">
            <span class="arrow" aria-hidden="true"> ← </span>{" "}
            All posts
          </a>
          <a class="btn btn-coral" href="/#contact">
            Work with me{" "}
            <span class="arrow" aria-hidden="true"> → </span>
          </a>
        </div>
      </footer>
    </article>
  </Container>

  <JsonLd schema={blogPosting} />
  <JsonLd schema={breadcrumb} />
</BaseLayout>

<style>
  article {
    display: grid;
    gap: var(--gap);
  }
  .post-head {
    padding: clamp(1.6rem, 1rem + 3vw, 3.5rem);
  }
  .post-head h1 {
    color: inherit;
    font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.75rem);
    max-width: 20ch;
  }
  .desc {
    max-width: 52ch;
    margin-top: 1.1rem;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    font-weight: 500;
  }
  .meta {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  .post-head .chips {
    margin-top: 1rem;
  }
  .post-head .chip {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .toc {
    margin-bottom: var(--space-8);
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc li {
    padding: 0.2rem 0;
  }
  .toc li.sub {
    padding-left: var(--space-4);
  }
  .toc a {
    font-weight: 600;
    text-decoration: none;
  }
  .toc a:hover {
    text-decoration: underline;
  }
  .post-foot {
    display: grid;
    gap: var(--gap);
  }
  .related h2 {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 2.75rem);
    padding: 1.5rem 0.5rem 0.75rem;
  }
  .related ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--gap);
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .related a {
    height: 100%;
    flex-direction: row;
    justify-content: space-between;
    gap: 1rem;
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
  .back {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
  }
</style>

<script>
  // Add copy buttons to code blocks
  document.querySelectorAll<HTMLPreElement>("pre.astro-code").forEach((pre) => {
    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.parentNode?.insertBefore(wrapper, pre);
    wrapper.appendChild(pre);
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-btn";
    btn.textContent = "Copy";
    btn.setAttribute("aria-label", "Copy code to clipboard");
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = "Copied";
        btn.dataset.copied = "true";
        setTimeout(() => {
          btn.textContent = "Copy";
          btn.dataset.copied = "false";
        }, 1500);
      } catch {}
    });
    wrapper.appendChild(btn);
  });
</script>
