---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
---

<BaseLayout title="Search — CodeBakkers" description="Search the CodeBakkers archive.">
  <Container>
    <section class="bento" aria-labelledby="search-h">
      <div class="tile tile-yellow page-head intro">
        <p class="label">Search</p>
        <h1 id="search-h" class="display">Search the archive</h1>
      </div>
      <div class="tile page-body">
        <div>
          <div id="search" class="pf"></div>
          <p id="search-fallback" class="fallback" hidden>
            The search index hasn't been built yet. Run <code>pnpm --filter codebakkers build</code
            >, or browse <a href="/blog">all posts</a>.
          </p>
          <noscript
            ><p>Search needs JavaScript. Browse <a href="/blog">all posts</a> instead.</p></noscript
          >
        </div>
      </div>
    </section>
  </Container>
</BaseLayout>

<script is:inline>
  // Pagefind assets only exist after a build (`pnpm --filter codebakkers build`).
  // Load them at runtime so the dev server doesn't 404 on missing files.
  (function () {
    function fallback() {
      const el = document.getElementById("search-fallback");
      if (el) el.hidden = false;
    }
    window.addEventListener("DOMContentLoaded", function () {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "/pagefind/pagefind-ui.css";
      css.onerror = fallback;
      document.head.appendChild(css);

      const js = document.createElement("script");
      js.src = "/pagefind/pagefind-ui.js";
      js.onerror = fallback;
      js.onload = function () {
        if (window.PagefindUI) {
          new window.PagefindUI({ element: "#search", showSubResults: true, showImages: false });
        } else {
          fallback();
        }
      };
      document.head.appendChild(js);
    });
  })();
</script>

<style>
  .intro {
    grid-column: 1 / -1;
    padding: clamp(1.6rem, 1rem + 3vw, 3rem);
  }
  .intro h1 {
    color: inherit;
  }
  .page-body a {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .fallback {
    color: var(--color-text-soft);
  }
  .pf {
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-background: var(--tile-bg);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-border-width: 2px;
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-tag: var(--color-bg);
  }
</style>
