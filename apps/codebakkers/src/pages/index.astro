<style>
  .bento h2,
  .bento h3 {
    color: inherit;
  }
  .hero {
    grid-column: span 7;
    grid-row: span 2;
    min-height: 560px;
    justify-content: space-between;
    padding: clamp(1.6rem, 1rem + 2vw, 2.5rem);
  }
  .hero h1 {
    font-size: clamp(3.1rem, 1.6rem + 4.4vw, 5.75rem);
  }
  .hero h1 em {
    font-style: normal;
    color: var(--cb-yellow);
  }
  .lead {
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.3rem);
    max-width: 36ch;
    margin-top: 1.4rem;
  }
  .lead strong {
    color: var(--tile-accent);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .photo {
    grid-column: span 3;
    grid-row: span 2;
    justify-content: flex-end;
    min-height: 360px;
  }
  .photo :global(picture),
  .photo :global(.portrait) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tag {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--cb-paper);
    color: var(--cb-ink);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
  }
  .tag b {
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }
  .tag span {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .now,
  .avail {
