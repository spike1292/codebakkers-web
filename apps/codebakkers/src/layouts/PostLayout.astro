---
import BaseLayout from "./BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import Prose from "@codebakkers/ui/components/Prose.astro";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}
const { title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${title} — CodeBakkers`} description={description}>
  <Container narrow>
    <article>
      <header class="post-header">
        <p class="kicker">NOTES FROM THE PLATFORM</p>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={iso(pubDate)}>{fmt(pubDate)}</time>
          {updatedDate && <span> · updated <time datetime={iso(updatedDate)}>{fmt(updatedDate)}</time></span>}
        </p>
        {tags.length > 0 && (
          <ul class="tags" aria-label="Tags">
            {tags.map((t) => <li>#{t}</li>)}
          </ul>
        )}
      </header>
      <Prose>
        <slot />
      </Prose>
      <footer class="post-footer">
        <a href="/">← All posts</a>
      </footer>
    </article>
  </Container>
</BaseLayout>

<style>
  .post-header { margin: var(--space-12) 0 var(--space-8); }
  .kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--color-accent-strong); margin-bottom: var(--space-3); }
  .meta { color: var(--color-muted); font-size: var(--step--1); margin-top: var(--space-3); }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: var(--space-2); padding: 0; margin: var(--space-4) 0 0; }
  .tags li { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-muted); background: var(--color-surface); border: 1px solid var(--color-border); padding: 0.1em 0.5em; border-radius: var(--radius-sm); }
  .post-footer { margin-top: var(--space-12); padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
</style>
