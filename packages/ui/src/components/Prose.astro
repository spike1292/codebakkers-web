---
/* Wrapper for long-form markdown content */
---

<div class="prose"><slot /></div>
<style>
  .prose {
    max-width: var(--measure);
    font-size: clamp(1.06rem, 1rem + 0.25vw, 1.18rem);
    line-height: 1.72;
  }
  .prose :global(h2) {
    font-size: var(--step-3);
    margin-top: var(--space-12);
    margin-bottom: var(--space-4);
  }
  .prose :global(h3) {
    font-size: var(--step-2);
    margin-top: var(--space-8);
    margin-bottom: var(--space-3);
  }
  .prose :global(h2::after) {
    content: "";
    display: block;
    width: 3rem;
    height: 6px;
    margin-top: 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--color-mark);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote),
  .prose :global(table) {
    margin-bottom: var(--space-6);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }
  .prose :global(li) {
    margin-bottom: var(--space-2);
  }
  .prose :global(li::marker) {
    color: var(--color-accent);
    font-weight: 700;
  }
  .prose :global(a:not(.btn)) {
    color: var(--color-accent);
    font-weight: 600;
  }
  .prose :global(a:not(.btn):hover) {
    color: var(--color-accent-strong);
  }
  .prose :global(strong) {
    font-weight: 750;
  }
  .prose :global(pre) {
    font-size: 0.9rem;
  }
  .prose :global(blockquote) {
    border-left: 6px solid var(--cb-yellow);
    background: var(--color-bg);
    border-radius: 0 var(--radius) var(--radius) 0;
    padding: var(--space-4) var(--space-6);
    font-size: 1.1em;
    font-weight: 600;
  }
  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(img) {
    border-radius: var(--radius);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95em;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: var(--space-2) var(--space-3);
    border-bottom: 2px solid var(--color-border);
  }
</style>
