---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" }).toUpperCase();
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={`${SITE.title} — ${SITE.tagline}`}>
  <Container>
    <section class="intro" aria-labelledby="intro-h">
      <p class="kicker">NOTES FROM THE PLATFORM</p>
      <h1 id="intro-h">Large-scale Angular modernization, <span class="accent">frontend&#8209;to&#8209;edge</span>.</h1>
      <p class="lead">{SITE.description}</p>
    </section>

    <section aria-label="Posts">
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`}>
              <time class="date" datetime={iso(post.data.pubDate)}>{fmt(post.data.pubDate)}</time>
              <span class="body">
                <span class="ptitle">{post.data.title}</span>
                <span class="pdesc">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {posts.length === 0 && <p class="empty">First post lands Monday.</p>}
    </section>
  </Container>
</BaseLayout>

<style>
  .intro { margin: var(--space-16) 0 var(--space-12); max-width: var(--measure); }
  .kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--color-accent-strong); margin-bottom: var(--space-3); }
  .intro h1 { font-size: var(--step-4); }
  .accent { color: var(--color-accent); }
  .lead { color: var(--color-text-soft); font-size: var(--step-1); margin-top: var(--space-4); }
  .posts { list-style: none; padding: 0; margin: 0; }
  .posts li + li { border-top: 1px solid var(--color-border); }
  .posts a { display: grid; grid-template-columns: 6rem 1fr; gap: var(--space-4); padding: var(--space-6) 0; text-decoration: none; color: inherit; align-items: baseline; }
  .date { font-family: var(--font-mono); font-size: var(--step--1); color: var(--color-muted); padding-top: 0.25em; }
  .body { display: flex; flex-direction: column; gap: var(--space-1); }
  .ptitle { font-size: var(--step-1); font-weight: 620; letter-spacing: -0.02em; }
  .pdesc { color: var(--color-muted); }
  .posts a:hover .ptitle { color: var(--color-accent); }
  .empty { color: var(--color-muted); padding: var(--space-8) 0; }
  @media (max-width: 34rem) {
    .posts a { grid-template-columns: 1fr; gap: var(--space-1); }
  }
</style>
