---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import JsonLd from "@codebakkers/ui/components/JsonLd.astro";
import { Picture } from "astro:assets";
import portrait from "../assets/henk.jpeg";
import { SITE } from "../consts";

const destinations = [
  {
    kicker: "THE PERSON",
    name: "Henk Bakker",
    href: "https://henkbakker.net",
    media: { kind: "photo" as const, src: portrait, alt: "Henk Bakker" },
    blurb:
      "Frontend platform engineering at scale — frontend to edge. Get to know Henk, the person behind CodeBakkers, and his work on open source, web performance, and frontend architecture.",
    cta: "henkbakker.net",
  },
  {
    kicker: "THE CONSULTANCY",
    name: "CodeCask",
    href: "https://www.codecask.cc",
    media: { kind: "logo" as const, src: "/codecask-logo.svg", alt: "Code Cask" },
    blurb:
      "Professional geeks delivering working software. Contact CodeCask for your platform, front end, or cloud work.",
    cta: "codecask.cc",
  },
];

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "CodeBakkers",
  url: SITE.url,
  email: SITE.email,
  founder: { "@type": "Person", name: "Henk Bakker", url: "https://henkbakker.net" },
  subOrganization: { "@type": "Organization", name: "CodeCask", url: "https://www.codecask.cc" },
};
---

<BaseLayout title="CodeBakkers — baked in, not bolted on">
  <Container>
    <section class="hero" aria-labelledby="hero-h">
      <p class="kicker">CODEBAKKERS</p>
      <h1 id="hero-h">Baked in, <span class="accent">not bolted on</span>.</h1>
      <p class="lead">
        CodeBakkers is Henk Bakker's personal brand and company. Looking for consultancy or
        front-end expertise? Henk works through <a href="https://www.codecask.cc">CodeCask</a>.
      </p>
    </section>

    <section aria-label="Where to go next">
      <div class="cards">
        {
          destinations.map((d) => (
            <article class="card">
              <div class={`media ${d.media.kind}`}>
                {d.media.kind === "photo" ? (
                  <Picture
                    src={d.media.src}
                    formats={["avif", "webp"]}
                    fallbackFormat="jpeg"
                    widths={[72, 144]}
                    sizes="72px"
                    width={72}
                    height={72}
                    alt={d.media.alt}
                    decoding="async"
                    loading="eager"
                  />
                ) : (
                  /* SVG — astro:assets doesn't optimise these, so it stays a plain img */
                  <img src={d.media.src} alt={d.media.alt} decoding="async" />
                )}
              </div>
              <p class="card-kicker">{d.kicker}</p>
              <h2>{d.name}</h2>
              <p class="blurb">{d.blurb}</p>
              <a class="go" href={d.href}>
                {d.cta} →
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="foot" aria-label="Company">
      <p>
        CodeBakkers B.V. · KVK 90011139 ·
        <a href="/company">company details</a> ·
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </section>
  </Container>
  <JsonLd schema={org} />
</BaseLayout>

<style>
  .hero {
    margin: var(--space-16) 0 var(--space-12);
    max-width: var(--measure);
  }
  .kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-3);
  }
  .hero h1 {
    font-size: var(--step-4);
  }
  .accent {
    color: var(--color-accent);
  }
  .lead {
    color: var(--color-text-soft);
    font-size: var(--step-1);
    margin-top: var(--space-4);
  }
  .cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }
  @media (max-width: 44rem) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
  .card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-8);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
  }
  /* Card media: round portrait for the person, logo on a light tile for the firm.
     The logo is an external SVG in an <img>, so it can't inherit currentColor —
     hence the fixed light tile, which keeps it legible in both themes. */
  .media {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-4);
    min-height: 72px;
  }
  .media.photo :global(img) {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }
  .media.logo {
    align-self: flex-start;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4);
  }
  .media.logo img,
  .media.logo :global(img) {
    height: 40px;
    width: auto;
    max-width: 100%;
    display: block;
  }
  .card-kicker {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    color: var(--color-muted);
  }
  .card h2 {
    margin: var(--space-2) 0 var(--space-3);
  }
  .blurb {
    color: var(--color-text-soft);
    margin-bottom: var(--space-6);
    flex: 1;
  }
  .go {
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
    color: var(--color-accent-strong);
  }
  .go:hover {
    color: var(--color-accent);
  }
  .foot {
    margin: var(--space-16) 0 var(--space-8);
    color: var(--color-muted);
    font-size: var(--step--1);
  }
</style>
