---
/**
 * Cloudflare Web Analytics — cookieless, no consent banner required.
 *
 * Enabled by PUBLIC_CF_BEACON_TOKEN at build time. Each site has its own token; CI injects
 * them per-project from the CF_BEACON_TOKEN_* secrets. When unset — local dev, previews,
 * forks — this renders nothing, so no beacon fires and nothing is collected.
 */
interface Props {
  /** Override the env token (rarely needed). */
  token?: string;
  /** Count client-side navigations too (Astro prefetch / view transitions). */
  spa?: boolean;
}
const { token = import.meta.env.PUBLIC_CF_BEACON_TOKEN, spa = true } = Astro.props;
const beacon = token ? JSON.stringify({ token, spa }) : null;
---

{
  beacon && (
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={beacon}
    />
  )
}
