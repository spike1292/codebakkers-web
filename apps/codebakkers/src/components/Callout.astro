---
interface Props { type?: "note" | "tip" | "warning"; title?: string; }
const { type = "note", title } = Astro.props;
const label = title ?? { note: "Note", tip: "Tip", warning: "Watch out" }[type];
---
<aside class={`callout ${type}`} role="note">
  <p class="callout-title">{label}</p>
  <div class="callout-body"><slot /></div>
</aside>
<style>
  .callout { border: 1px solid var(--color-border); border-left-width: 4px; border-radius: var(--radius-sm); padding: var(--space-4) var(--space-6); margin: var(--space-6) 0; background: var(--color-surface); }
  .callout-title { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: var(--space-2); color: var(--color-accent-strong); }
  .callout.warning { border-left-color: #c0562b; }
  .callout.warning .callout-title { color: #c0562b; }
  .callout.tip { border-left-color: var(--color-accent); }
  .callout-body :global(p:last-child) { margin-bottom: 0; }
</style>
