---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
---

<BaseLayout title="Not found — CodeBakkers" description="Page not found.">
  <Container narrow>
    <section>
      <p class="kicker">404</p>
      <h1>That page didn't compile</h1>
      <p class="lead">The link is broken or the page has moved. Try the <a href="/">blog index</a> or <a href="/search">search</a>.</p>
    </section>
  </Container>
</BaseLayout>

<style>
  section { margin: var(--space-16) 0; }
  .kicker { font-family: var(--font-mono); font-size: var(--step--1); letter-spacing: 0.12em; color: var(--color-accent-strong); margin-bottom: var(--space-3); }
  .lead { color: var(--color-text-soft); font-size: var(--step-1); margin-top: var(--space-4); }
</style>
