---
interface Props { label?: string; href?: string; }
const { label = "CodeBakkers", href = "/" } = Astro.props;
---
<a class="logo" href={href} aria-label={label}>
  <span class="mark" aria-hidden="true">{"{"}<span class="mark-dot">CB</span>{"}"}</span>
  <span class="wordmark">{label}</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: 700; color: var(--color-text); text-decoration: none; letter-spacing: -0.02em; }
  .mark { font-family: var(--font-mono); color: var(--color-muted); font-weight: 600; }
  .mark-dot { color: var(--color-accent); }
  .logo:hover .wordmark { color: var(--color-accent); }
</style>
