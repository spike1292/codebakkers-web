---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@codebakkers/ui/components/Container.astro";
import JsonLd from "@codebakkers/ui/components/JsonLd.astro";
import { Picture } from "astro:assets";
import { getCollection } from "astro:content";
import portrait from "../assets/henk.jpeg";
import essent from "../assets/logos/essent.svg";
import ing from "../assets/logos/ing.svg";
import ns from "../assets/logos/ns.svg";
import abnAmro from "../assets/logos/abn-amro.svg";
import sogeti from "../assets/logos/sogeti.svg";
import codecask from "../assets/logos/codecask.svg";
import { SITE } from "../consts";

const now = new Date();
const years = now.getFullYear() - 2013 - (now.getMonth() < 9 ? 1 : 0);

const logos = [
  { name: "Essent", logo: essent },
  { name: "ING", logo: ing },
  { name: "NS", logo: ns },
  { name: "Kadaster" },
  { name: "ABN AMRO", logo: abnAmro },
  { name: "Quintor" },
  { name: "Sogeti", logo: sogeti },
  { name: "Codecask", logo: codecask },
];

const stack = [
  "Angular",
  "Nx",
  "TypeScript",
  "NgRx",
  "SSR",
  "Node.js",
  "React",
  "Astro",
  "AWS CloudFront",
  "CloudFront Functions",
  "AWS CDK",
  "ECS / Fargate",
  "GitLab CI",
  "Cypress",
  "Playwright",
  "Claude Code",
];

const teamFills = ["#FFFBF2", "#FFC93C", "#8FCBF0", "#FF6B4A", "#FFC2B0", "#A8DDB5"];
const teams = Array.from({ length: 22 }, (_, i) => teamFills[i % teamFills.length]);

const noteColors = ["tile-blush", "tile-paper", "tile-sky"];
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" }).toUpperCase();
const iso = (d: Date) => d.toISOString().slice(0, 10);

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Henk Bakker",
  url: SITE.url,
  jobTitle: "Frontend Platform Lead",
  description: "Large-scale migrations without a stop in delivery.",
  sameAs: [SITE.github, SITE.linkedin],
  worksFor: { "@type": "Organization", name: "Codecask", url: "https://www.codecask.cc" },
  knowsAbout: [
    "Frontend platform engineering",
    "Large-scale migrations",
    "Monorepos",
    "Nx",
    "Angular",
    "TypeScript",
    "CI/CD",
    "AWS CloudFront",
    "AWS CDK",
  ],
};
---

<BaseLayout
  title="Henk Bakker · Frontend Platform Lead — large-scale migrations without a stop in delivery"
>
  <Container>
    <section class="bento" aria-labelledby="hero-h">
      <div class="tile tile-ink hero">
        <div>
          <p class="label">Frontend Platform Lead</p>
          <h1 id="hero-h" class="display">
            Your teams keep <em>shipping.</em> Your platform moves <span class="hl">forward.</span>
          </h1>
          <p class="lead">
            <strong>Large-scale migrations without a stop in delivery.</strong> I help organisations move
            big frontend platforms forward with planned migrations, safe releases and simple tooling.
          </p>
        </div>
        <div class="ctas">
          <a class="btn btn-yellow" href="#contact"
            >Let's plan the first step <span class="arrow" aria-hidden="true">→</span></a
          >
          <a class="btn" href="#work">See three migrations</a>
        </div>
      </div>

      <div class="tile tile-coral photo">
        <Picture
          class="portrait"
          src={portrait}
          formats={["avif", "webp"]}
          fallbackFormat="jpeg"
          widths={[320, 480, 720]}
          sizes="(max-width: 40rem) 100vw, (max-width: 68rem) 50vw, 25vw"
          alt="Portrait of Henk Bakker"
          loading="eager"
          fetchpriority="high"
        />
        <p class="tag"><b>Henk Bakker</b><span>Frontend Platform Lead</span></p>
      </div>

      <div class="tile tile-yellow now">
        <p class="label">Currently</p>
        <h2>Frontend Platform Lead @&nbsp;Essent</h2>
        <p>My team runs the web platform that ~22 feature teams build on.</p>
      </div>

      <div class="tile tile-pine avail">
        <div>
          <p class="label">Availability</p>
          <h2>Need a platform lead?</h2>
          <p>Freelance or secondment via Codecask. Remote or hybrid.</p>
        </div>
        <a class="btn btn-yellow" href="#contact">Tell me about your platform</a>
      </div>
    </section>

    <section class="bento" aria-labelledby="schem-h">
      <div class="tile tile-sky dots schem">
        <div class="top">
          <div>
            <p class="label">What we run — repo to user</p>
            <h2 id="schem-h" class="display">From one repo to six brand apps.</h2>
          </div>
          <p>
            The monorepo, the pipeline, server-side rendering (SSR) and the CDN edge. My team looks
            after every step.
          </p>
        </div>

        <svg
          class="drawing h"
          viewBox="0 0 1200 360"
          role="img"
          aria-label="Schematic: an Nx monorepo of 500 projects goes through build and CI to an SSR origin, behind the AWS CloudFront edge defined in CDK, serving six brand apps. Owned end to end."
        >
          <defs>
            <marker
              id="sa"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor"></path></marker
            >
            <marker
              id="stk"
              viewBox="0 0 10 10"
              refX="5"
              refY="5"
              markerWidth="10"
              markerHeight="10"
              orient="auto"><path d="M5 0V10" stroke="currentColor" stroke-width="2"></path></marker
            >
          </defs>
          <g stroke="#15211C" stroke-width="2.5">
            <rect
              x="46"
              y="114"
              width="180"
              height="100"
              rx="18"
              fill="#FFFBF2"
              fill-opacity=".45"
              stroke-opacity=".5"></rect>
            <rect
              x="38"
              y="122"
              width="180"
              height="100"
              rx="18"
              fill="#FFFBF2"
              fill-opacity=".7"
              stroke-opacity=".75"></rect>
            <rect x="30" y="130" width="180" height="100" rx="18" fill="#FFFBF2"></rect>
            <rect x="270" y="130" width="180" height="100" rx="18" fill="#FFFBF2"></rect>
            <rect x="510" y="130" width="180" height="100" rx="18" fill="#A8DDB5"></rect>
            <rect x="750" y="120" width="200" height="120" rx="22" fill="#FFC93C" stroke-width="3"
            ></rect>
            <rect x="1010" y="130" width="160" height="100" rx="18" fill="#FF6B4A"></rect>
          </g>
          <g stroke="currentColor" stroke-width="2.5" fill="none">
            <path d="M232 180H262" marker-end="url(#sa)"></path>
            <path d="M452 180H502" marker-end="url(#sa)"></path>
            <path d="M692 180H742" marker-end="url(#sa)"></path>
            <path d="M952 180H1002" marker-end="url(#sa)"></path>
          </g>
          <g fill="#15211C">
            <text class="sb" x="48" y="156" font-size="11" opacity=".7">01 / SOURCE</text>
            <text class="sv" x="48" y="190" font-size="23">Nx monorepo</text>
            <text class="sm" x="48" y="214" font-size="12">500 projects</text>
            <text class="sb" x="288" y="156" font-size="11" opacity=".7">02 / PIPELINE</text>
            <text class="sv" x="288" y="190" font-size="23">Build &amp; CI</text>
            <text class="sm" x="288" y="214" font-size="12">GitLab CI · Cypress</text>
            <text class="sb" x="528" y="156" font-size="11" opacity=".7">03 / ORIGIN</text>
            <text class="sv" x="528" y="190" font-size="23">SSR origin</text>
            <text class="sm" x="528" y="214" font-size="12">Angular SSR</text>
            <text class="sb" x="770" y="148" font-size="11" opacity=".7">04 / EDGE</text>
            <text class="sv" x="770" y="184" font-size="27">CDN edge</text>
            <text class="sm" x="770" y="208" font-size="12">AWS CloudFront</text>
            <text class="sm" x="770" y="226" font-size="12">defined in CDK</text>
            <text class="sb" x="1028" y="156" font-size="11" opacity=".7">05 / USERS</text>
            <text class="sv" x="1028" y="188" font-size="20">6 brand apps</text>
          </g>
          <g stroke="#15211C" stroke-width="2">
            {
              teamFills.map((fill, i) => (
                <circle cx={1038 + i * 22} cy="210" r="7" fill={i === 5 ? "#15211C" : fill} />
              ))
            }
          </g>
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-dasharray="4 4"
            opacity=".75"
          >
            <path d="M136 114V66H236"></path>
            <path d="M360 130V100H452"></path>
            <path d="M850 120V56H960"></path>
            <path d="M600 230V290H700"></path>
          </g>
          <g fill="#FF6B4A" stroke="#15211C" stroke-width="2">
            <circle cx="136" cy="114" r="5"></circle><circle cx="360" cy="130" r="5"
            ></circle><circle cx="850" cy="120" r="5"></circle><circle cx="600" cy="230" r="5"
            ></circle>
          </g>
          <g class="sm" font-size="13" fill="currentColor">
            <text x="244" y="71"
              ><tspan class="sb">A</tspan> · one foundation, ~22 teams build on it</text
            >
            <text x="460" y="105"
              ><tspan class="sb">B</tspan> · every change builds, tests, ships</text
            >
            <text x="968" y="52"><tspan class="sb">C</tspan> · redirects, apps domains</text>
            <text x="968" y="70">in CloudFront Functions</text>
            <text x="708" y="295"
              ><tspan class="sb">D</tspan> · server-rendered, cached at the edge</text
            >
          </g>
          <g stroke="currentColor" stroke-width="1.5" fill="none">
            <path d="M30 330H1170" marker-start="url(#stk)" marker-end="url(#stk)"></path>
            <path d="M30 238V338M1170 238V338" stroke-dasharray="2 4"></path>
          </g>
          <rect class="pill" x="496" y="318" width="208" height="24" rx="12"></rect>
          <text
            class="sb pill-t"
            x="600"
            y="334.5"
            font-size="12"
            text-anchor="middle"
            letter-spacing="2">OWNED END TO END</text
          >
        </svg>

        <svg
          class="drawing v"
          viewBox="0 0 340 664"
          role="img"
          aria-label="Schematic: an Nx monorepo of 500 projects goes through build and CI to an SSR origin, behind the AWS CloudFront edge defined in CDK, serving six brand apps. Owned end to end."
        >
          <defs>
            <marker
              id="sav"
              viewBox="0 0 10 10"
              refX="8"
              refY="5"
              markerWidth="7"
              markerHeight="7"
              orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor"></path></marker
            >
          </defs>
          <g stroke="#15211C" stroke-width="2.5">
            <rect
              x="72"
              y="12"
              width="262"
              height="84"
              rx="16"
              fill="#FFFBF2"
              fill-opacity=".6"
              stroke-opacity=".6"></rect>
            <rect x="64" y="20" width="262" height="84" rx="16" fill="#FFFBF2"></rect>
            <rect x="64" y="144" width="262" height="84" rx="16" fill="#FFFBF2"></rect>
            <rect x="64" y="268" width="262" height="84" rx="16" fill="#A8DDB5"></rect>
            <rect x="64" y="392" width="262" height="118" rx="20" fill="#FFC93C" stroke-width="3"
            ></rect>
            <rect x="64" y="550" width="262" height="104" rx="16" fill="#FF6B4A"></rect>
          </g>
          <g stroke="currentColor" stroke-width="2.5" fill="none">
            <path d="M195 108V138" marker-end="url(#sav)"></path>
            <path d="M195 232V262" marker-end="url(#sav)"></path>
            <path d="M195 356V386" marker-end="url(#sav)"></path>
            <path d="M195 514V544" marker-end="url(#sav)"></path>
          </g>
          <g fill="#15211C">
            <text class="sb" x="84" y="42" font-size="11" opacity=".7">01 / SOURCE</text>
            <text class="sv" x="84" y="70" font-size="22">Nx monorepo</text>
            <text class="sm" x="84" y="92" font-size="12">500 projects, one foundation</text>
            <text class="sb" x="84" y="166" font-size="11" opacity=".7">02 / PIPELINE</text>
            <text class="sv" x="84" y="194" font-size="22">Build &amp; CI</text>
            <text class="sm" x="84" y="216" font-size="12">GitLab CI · Cypress</text>
            <text class="sb" x="84" y="290" font-size="11" opacity=".7">03 / ORIGIN</text>
            <text class="sv" x="84" y="318" font-size="22">SSR origin</text>
            <text class="sm" x="84" y="340" font-size="12">Angular SSR</text>
            <text class="sb" x="84" y="414" font-size="11" opacity=".7">04 / EDGE</text>
            <text class="sv" x="84" y="446" font-size="25">CDN edge</text>
            <text class="sm" x="84" y="470" font-size="12">CloudFront · defined in CDK</text>
            <text class="sm" x="84" y="490" font-size="12">redirects · apps domains</text>
            <text class="sb" x="84" y="572" font-size="11" opacity=".7">05 / USERS</text>
            <text class="sv" x="84" y="602" font-size="22">6 brand apps</text>
          </g>
          <g stroke="#15211C" stroke-width="2">
            {
              teamFills.map((fill, i) => (
                <circle cx={94 + i * 24} cy="628" r="8" fill={i === 5 ? "#15211C" : fill} />
              ))
            }
          </g>
          <g stroke="currentColor" stroke-width="1.5" fill="none">
            <path d="M34 20V654"></path><path d="M26 20H42M26 654H42"></path>
          </g>
          <rect class="pill" x="22" y="250" width="24" height="180" rx="12"></rect>
          <text
            class="sb pill-t"
            font-size="11"
            letter-spacing="2"
            transform="translate(38.5 340) rotate(-90)"
            text-anchor="middle">OWNED END TO END</text
          >
        </svg>
      </div>
    </section>

    <section class="bento" aria-label="In numbers">
      <div class="tile tile-mint stat">
        <p class="label">Monorepo scale</p>
        <p class="n display">500</p>
        <p>projects in one Nx monorepo, one foundation</p>
      </div>
      <div class="tile tile-coral stat">
        <p class="label">Brands</p>
        <p class="n display">6</p>
        <p>brand apps on the platform my team owns</p>
      </div>
      <div class="tile tile-blush stat">
        <p class="label">Cloud move</p>
        <p class="n display">29<small>%</small></p>
        <p>lower origin latency after our cloud move</p>
      </div>
      <div class="tile tile-yellow stat">
        <p class="label">Experience</p>
        <p class="n display">{years}<small> yrs</small></p>
        <p>building frontends, since October 2013</p>
      </div>
    </section>

    <section class="bento" aria-labelledby="logos-h">
      <div class="tile logos">
        <p class="label">Worked with</p>
        <h2 id="logos-h">Where I have<br />worked.</h2>
        <ul class="logo-grid">
          {
            logos.map(({ name, logo }) => (
              <li>
                {logo ? (
                  <span
                    class="logo-mark"
                    role="img"
                    aria-label={name}
                    style={`--logo: url(${logo.src}); --ratio: ${logo.width / logo.height}`}
                  />
                ) : (
                  <span class="logo-word">{name}</span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="tile tile-sky loc">
        <div class="map" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
        <p class="label">Based in</p>
        <h2 class="display">Uithuizen</h2>
        <p>the Netherlands · remote or hybrid</p>
      </div>
    </section>

    <section class="bento" id="services" aria-labelledby="services-h">
      <div class="head">
        <h2 id="services-h" class="display">Where I can <em class="hl">help.</em></h2>
        <p>Four problems that slow down large frontend teams, and what I do about each one.</p>
      </div>
      <div class="tile tile-ink svc">
        <div class="row">
          <p class="num">01</p>
          <svg
            class="ico"
            viewBox="0 0 72 72"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            aria-hidden="true"
            ><path d="M8 52L36 64L64 52"></path><path d="M8 40L36 52L64 40"></path><path
              d="M8 28L36 16L64 28L36 40Z"
              fill="#FFC93C"
              stroke="#FFC93C"></path></svg
          >
        </div>
        <div>
          <h3>Frontend platform foundations</h3>
          <p>Shared libraries, conventions and tooling that let many teams build on one base.</p>
        </div>
      </div>
      <div class="tile tile-coral svc">
        <div class="row">
          <p class="num">02</p>
          <svg
            class="ico"
            viewBox="0 0 72 72"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linejoin="round"
            stroke-linecap="round"
            aria-hidden="true"
            ><rect x="6" y="22" width="22" height="28" rx="5"></rect><rect
              x="44"
              y="22"
              width="22"
              height="28"
              rx="5"
              fill="#FFFBF2"
              stroke="#15211C"></rect><path d="M30 36H40"></path><path d="M36 31L41 36L36 41"
            ></path><path d="M6 60H66" stroke-dasharray="4 5"></path></svg
          >
        </div>
        <div>
          <h3>Large migrations without stopping delivery</h3>
          <p>
            Framework-wide changes across hundreds of projects, planned as a process, while features
            keep shipping.
          </p>
        </div>
      </div>
      <div class="tile tile-sky svc">
        <div class="row">
          <p class="num">03</p>
          <svg
            class="ico"
            viewBox="0 0 72 72"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            aria-hidden="true"
            ><circle cx="12" cy="36" r="7"></circle><circle cx="36" cy="36" r="7"></circle><circle
              cx="60"
              cy="36"
              r="7"
              fill="#FFC93C"
              stroke="#15211C"></circle><path d="M19 36H29M43 36H53"></path><path
              d="M12 22V14H60V22"
              stroke-dasharray="3 4"></path></svg
          >
        </div>
        <div>
          <h3>Build &amp; CI pipelines</h3>
          <p>Smaller build artifacts, fewer end-to-end test runs, and checks teams trust.</p>
        </div>
      </div>
      <div class="tile tile-pine svc">
        <div class="row">
          <p class="num">04</p>
          <svg
            class="ico"
            viewBox="0 0 72 72"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
            ><circle cx="36" cy="36" r="26" fill="#A8DDB5" fill-opacity=".25"></circle><ellipse
              cx="36"
              cy="36"
              rx="11"
              ry="26"></ellipse><path d="M10 36H62M14 22H58M14 50H58"></path></svg
          >
        </div>
        <div>
          <h3>Cloud &amp; CDN edge</h3>
          <p>
            AWS CloudFront and CDK: DNS, redirects and domains at the edge, as code, with rehearsed
            rollbacks.
          </p>
        </div>
      </div>
    </section>

    <section class="bento" aria-label="Stack and way of working">
      <div class="tile stack">
        <p class="label">Stack</p>
        <h2>Tools I run in production.</h2>
        <ul class="chips">{stack.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
      <div class="tile tile-ink how">
        <p class="label">How I work</p>
        <h2 class="display">Evidence over assumptions. <em>Simple over clever.</em></h2>
        <ul>
          <li>Migrations planned as a process, with deadlines and a test round for every team.</li>
          <li>Releases made safe: rehearsed rollbacks and written runbooks.</li>
          <li>Teams enabled to do it themselves, not waiting on me.</li>
        </ul>
      </div>
    </section>

    <section class="bento" id="work" aria-labelledby="work-h">
      <div class="head">
        <h2 id="work-h" class="display">What this looked like <em class="hl">at Essent.</em></h2>
        <p>
          Three changes my team and I made, before and after. Each one shipped while the feature
          teams kept working. More detail is on my <a href="/cv">CV</a>.
        </p>
      </div>

      <article class="tile tile-pine case case-a" aria-labelledby="case1-h">
        <div class="txt">
          <p class="label">Case 01 — Cloud &amp; edge</p>
          <h3 id="case1-h">Two brands moved to a new cloud platform</h3>
          <p>
            essent.nl and energiedirect.nl ran on an older AWS setup. We made the move safe to run:
            DNS and the edge rebuilt in AWS CDK, a rehearsed rollback drill and written runbooks.
            Both brands switched with seconds of downtime and no rollback. Since then, redirects and
            the apps domains moved to the edge. The last nginx tier is next.
          </p>
          <ul class="tags">
            <li>seconds of downtime</li>
            <li>29% lower origin latency</li>
            <li>lower AWS cost</li>
            <li>CloudFront Functions</li>
            <li>AWS CDK</li>
          </ul>
        </div>
        <div class="draw dots">
          <svg
            class="drawing h"
            viewBox="0 0 560 170"
            role="img"
            aria-label="Before, on the older AWS setup: users, then the CDN, then an nginx tier that handled redirects and the apps domains, then the SSR origin."
          >
            <defs>
              <marker
                id="c1a"
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="7"
                markerHeight="7"
                orient="auto"><path d="M0 0L10 5L0 10z" fill="currentColor"></path></marker
              >
            </defs>
            <text class="sb" x="0" y="16" font-size="12" fill="#A8DDB5" letter-spacing="2"
              >BEFORE · OLDER AWS SETUP</text
            >
            <rect x="0" y="50" width="96" height="70" rx="14" fill="#FFFBF2"></rect>
            <rect x="136" y="50" width="100" height="70" rx="14" fill="#FFFBF2"></rect>
            <rect x="276" y="50" width="130" height="70" rx="14" fill="#FFFBF2"></rect>
            <rect x="446" y="50" width="114" height="70" rx="14" fill="#A8DDB5"></rect>
            <g stroke="currentColor" stroke-width="2.5">
              <path d="M98 85H128" marker-end="url(#c1a)"></path>
              <path d="M238 85H268" marker-end="url(#c1a)"></path>
              <path d="M408 85H438" marker-end="url(#c1a)"></path>
            </g>
            <g fill="#15211C" text-anchor="middle">
